<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:CityExplorer.Resources.Strings"
             x:Class="CityExplorer.Views.ExplorePage"
             x:Name="ExplorePageRoot"
             Title="{Binding [Tab_Explore], Source={x:Static strings:LocalizationResourceManager.Instance}}"
             BackgroundColor="#170800">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <Grid Grid.Row="0" BackgroundColor="#ea580c" Padding="20,16,20,18">
            <VerticalStackLayout Spacing="2">
                <Label Text="CityExplorer"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="White"/>
                <Label Text="{Binding [Explore_Subtitle], Source={x:Static strings:LocalizationResourceManager.Instance}}"
                       FontSize="12"
                       TextColor="#ffd5a8"/>
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Row="1" BackgroundColor="#ea580c" Padding="16,0,16,16">
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">

                <Border Padding="20,10"
                        StrokeShape="RoundRectangle 20"
                        Stroke="Transparent"
                        BackgroundColor="#b84000">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectCategoryCommand}"
                                              CommandParameter="{Binding Categories[0]}"/>
                    </Border.GestureRecognizers>
                    <Label Text="{Binding [Category_History], Source={x:Static strings:LocalizationResourceManager.Instance}}"
                           FontSize="13" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                </Border>

                <Border Padding="20,10"
                        StrokeShape="RoundRectangle 20"
                        Stroke="Transparent"
                        BackgroundColor="#b84000">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectCategoryCommand}"
                                              CommandParameter="{Binding Categories[1]}"/>
                    </Border.GestureRecognizers>
                    <Label Text="{Binding [Category_Parks], Source={x:Static strings:LocalizationResourceManager.Instance}}"
                           FontSize="13" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                </Border>

                <Border Padding="20,10"
                        StrokeShape="RoundRectangle 20"
                        Stroke="Transparent"
                        BackgroundColor="#b84000">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectCategoryCommand}"
                                              CommandParameter="{Binding Categories[2]}"/>
                    </Border.GestureRecognizers>
                    <Label Text="{Binding [Category_Food], Source={x:Static strings:LocalizationResourceManager.Instance}}"
                           FontSize="13" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                </Border>

            </HorizontalStackLayout>
        </Grid>

        <CarouselView Grid.Row="2"
                      x:Name="PlacesCarousel"
                      ItemsSource="{Binding Places}"
                      IndicatorView="PlacesIndicator"
                      Position="{Binding CurrentPosition, Mode=TwoWay}"
                      PeekAreaInsets="20"
                      Loop="False"
                      Margin="0,16,0,0">
            <CarouselView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8,0">
                        <Border Stroke="Transparent"
                                StrokeShape="RoundRectangle 22"
                                BackgroundColor="#251200">
                            <Border.Shadow>
                                <Shadow Brush="#000000" Opacity="0.40" Radius="20" Offset="0,6"/>
                            </Border.Shadow>

                            <Grid RowDefinitions="200,Auto">

                                <Grid Grid.Row="0">
                                    <Grid.Clip>
                                        <RoundRectangleGeometry Rect="0,0,600,200" CornerRadius="22,22,0,0"/>
                                    </Grid.Clip>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.ShowDetailsCommand, Source={x:Reference ExplorePageRoot}}"
                                            CommandParameter="{Binding .}"/>
                                    </Grid.GestureRecognizers>

                                    <BoxView BackgroundColor="{Binding CardColor}"/>
                                    <Image Source="{Binding ImageUrl}" Aspect="AspectFill"/>
                                    <BoxView BackgroundColor="#80000000"
                                             VerticalOptions="End"
                                             HeightRequest="90"/>
                                    <Label Text="{Binding Name}"
                                           TextColor="White"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           VerticalOptions="End"
                                           Margin="16,0,16,14"
                                           Shadow="{Shadow Brush=Black, Radius=4, Opacity=0.6}"/>
                                </Grid>

                                <VerticalStackLayout Grid.Row="1" Padding="16,14,16,16" Spacing="10">
                                    <Label Text="{Binding Description}"
                                           FontSize="13"
                                           TextColor="#d4a07a"
                                           LineBreakMode="WordWrap"/>
                                    <Label Text="{Binding Address}"
                                           FontSize="12"
                                           TextColor="#7a4020"/>
                                    <Button
                                        Text="{Binding [Btn_AddFavorites], Source={x:Static strings:LocalizationResourceManager.Instance}}"
                                        BackgroundColor="#ea580c"
                                        TextColor="White"
                                        CornerRadius="12"
                                        HeightRequest="46"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        Command="{Binding BindingContext.AddToFavoritesCommand, Source={x:Reference ExplorePageRoot}}"
                                        CommandParameter="{Binding .}">
                                        <Button.Shadow>
                                            <Shadow Brush="#ea580c" Opacity="0.40" Radius="10" Offset="0,4"/>
                                        </Button.Shadow>
                                    </Button>
                                </VerticalStackLayout>

                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <IndicatorView Grid.Row="3"
                       x:Name="PlacesIndicator"
                       IndicatorColor="#4a2010"
                       SelectedIndicatorColor="#ea580c"
                       IndicatorSize="8"
                       HorizontalOptions="Center"
                       Margin="0,10,0,14"/>

    </Grid>
</ContentPage>
